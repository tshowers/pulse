rules_version = '2';

// Emulator-only rules for Cypress coverage (cypress/e2e/*.cy.ts run against
// `firebase emulators:start`, never against the real taliferrotech
// project). Mirrors the actual access shape PulseAuthService.resolveTenantId
// relies on: it reads users/{uid}.companyId and falls back to the uid
// itself as the tenant when that's unset - which is always true for a
// freshly created emulator user - so this only needs to allow a signed-in
// user to read their own users/{uid} doc.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
  }
}
