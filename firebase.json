{
  "hosting": {
    "site": "todd-pulse",
    "public": "dist/pulse/browser",
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.csr.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9299
    },
    "firestore": {
      "port": 8280
    },
    "ui": {
      "enabled": true,
      "port": 4501
    }
  }
}
